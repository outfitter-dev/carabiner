{
  "name": "@carabiner/types",
  "description": "Type system foundation for Carabiner hooks",
  "version": "0.1.0-alpha",
  "author": "Outfitter Dev <hello@outfitter.dev>",
  "bugs": "https://github.com/outfitter-dev/carabiner/issues",
  "dependencies": {
    "type-fest": "^5.3.1"
  },
  "devDependencies": {
    "@types/bun": "*",
    "typescript": "^5.9.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./brands": {
      "types": "./dist/brands.d.ts",
      "import": "./dist/brands.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/outfitter-dev/carabiner/tree/main/packages/types#readme",
  "keywords": [
    "ai-tools",
    "automation",
    "branded-types",
    "carabiner",
    "claude-code",
    "developer-tools",
    "hooks",
    "types",
    "typescript"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outfitter-dev/carabiner.git",
    "directory": "packages/types"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
