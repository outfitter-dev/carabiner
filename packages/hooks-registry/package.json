{
  "name": "@carabiner/hooks-registry",
  "description": "Official registry of Claude Code hooks",
  "version": "0.1.0-alpha",
  "author": "Matt Galligan <matt.galligan@gmail.com>",
  "dependencies": {
    "@carabiner/execution": "0.1.0-alpha",
    "@carabiner/protocol": "0.1.0-alpha",
    "@carabiner/schemas": "0.1.0-alpha",
    "@carabiner/types": "0.1.0-alpha",
    "picomatch": "^4.0.3"
  },
  "devDependencies": {
    "@types/bun": "*",
    "@types/node": "^24.3.1",
    "@types/picomatch": "^4.0.2",
    "type-fest": "^4.41.0",
    "typescript": "^5.9.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "claude-code",
    "formatters",
    "hooks",
    "linters",
    "registry"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2"
  },
  "peerDependenciesMeta": {
    "markdownlint-cli2": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/outfitter-dev/carabiner.git",
    "directory": "packages/hooks-registry"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
