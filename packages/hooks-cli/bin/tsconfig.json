{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "allowImportingTsExtensions": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": ["*.ts"]
}
