{
  "name": "@carabiner/plugins",
  "description": "Example plugin collection for Carabiner hooks - demonstrates plugin architecture patterns",
  "version": "0.1.0-alpha",
  "author": "Outfitter Team",
  "dependencies": {
    "@carabiner/execution": "0.1.0-alpha",
    "@carabiner/hooks-core": "0.1.0-alpha",
    "@carabiner/registry": "0.1.0-alpha",
    "@carabiner/types": "0.1.0-alpha",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "bun-types": "^1.0.25",
    "typescript": "^5.9.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./git-safety": {
      "types": "./dist/git-safety/index.d.ts",
      "import": "./dist/git-safety/index.js"
    },
    "./file-backup": {
      "types": "./dist/file-backup/index.d.ts",
      "import": "./dist/file-backup/index.js"
    },
    "./security-scanner": {
      "types": "./dist/security-scanner/index.d.ts",
      "import": "./dist/security-scanner/index.js"
    },
    "./performance-monitor": {
      "types": "./dist/performance-monitor/index.d.ts",
      "import": "./dist/performance-monitor/index.js"
    },
    "./audit-logger": {
      "types": "./dist/audit-logger/index.d.ts",
      "import": "./dist/audit-logger/index.js"
    }
  },
  "keywords": [
    "audit",
    "carabiner",
    "examples",
    "file-backup",
    "git-safety",
    "hooks",
    "performance",
    "plugins",
    "security"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/outfitter-dev/carabiner",
    "directory": "packages/plugins"
  },
  "scripts": {
    "build": "bun run build:clean && bun run build:tsc",
    "build:clean": "rm -rf dist",
    "build:tsc": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "dev": "tsc --project tsconfig.build.json --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
