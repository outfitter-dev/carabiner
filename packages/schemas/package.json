{
  "name": "@carabiner/schemas",
  "description": "Zod validation schemas for Carabiner hooks",
  "version": "0.1.0-alpha",
  "author": "Outfitter Dev <hello@outfitter.dev>",
  "bugs": "https://github.com/outfitter-dev/carabiner/issues",
  "dependencies": {
    "@carabiner/types": "0.1.0-alpha",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bun": "*",
    "typescript": "^5.9.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/outfitter-dev/carabiner#readme",
  "keywords": [
    "ai-tools",
    "automation",
    "carabiner",
    "claude-code",
    "developer-tools",
    "hooks",
    "schemas",
    "typescript",
    "validation",
    "zod"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outfitter-dev/carabiner.git",
    "directory": "packages/schemas"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
