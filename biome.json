{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "extends": ["ultracite"],
  "javascript": {
    "globals": ["Bun"]
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**/*.{js,ts,jsx,tsx,json,jsonc}"],
    "experimentalScannerIgnores": [
      "**/.conductor/**",
      ".carabiner/**",
      "packages/**/bin/**/*.mjs"
    ]
  },
  "vcs": {
    "useIgnoreFile": true
  },
  "overrides": [
    {
      "includes": ["packages/**/bin/**/*.mjs"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "packages/hooks-cli/bin/**/*.{js,mjs,ts}",
        "packages/hooks-cli/src/**/*.{js,ts,tsx}"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noAssignInExpressions": "off"
          },
          "nursery": {
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/examples/src/**/*.{js,ts}"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "style": {
        "noMagicNumbers": "off",
        "noEnum": "off",
        "noParameterProperties": "off",
        "useConsistentMemberAccessibility": "off",
        "noNonNullAssertion": "off",
        "useThrowOnlyError": "off",
        "noNestedTernary": "off",
        "useDefaultSwitchClause": "off",
        "useForOf": "off"
      },
      "complexity": {
        "noVoid": "off",
        "noExcessiveCognitiveComplexity": "off",
        "noExcessiveLinesPerFunction": "off",
        "noForEach": "off",
        "noStaticOnlyClass": "off"
      },
      "performance": {
        "useTopLevelRegex": "off",
        "noBarrelFile": "off",
        "noNamespaceImport": "off"
      },
      "suspicious": {
        "useAwait": "off",
        "noEmptyBlockStatements": "off",
        "noConsole": "error",
        "noEvolvingTypes": "off",
        "noTsIgnore": "off",
        "noExplicitAny": "off",
        "noImplicitAnyLet": "off",
        "useIterableCallbackReturn": "off"
      },
      "nursery": {
        "noShadow": "off",
        "noUnnecessaryConditions": "off",
        "useMaxParams": "off"
      },
      "correctness": {
        "noUnusedVariables": "off"
      }
    }
  }
}
